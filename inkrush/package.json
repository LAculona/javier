{
  "name": "inkrush",
  "version": "1.0.0",
  "private": true,
  "description": "INKRUSH - shooter 3D de pintura en tercera persona (Three.js)",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/inkrush.js",
    "watch": "esbuild src/main.js --bundle --sourcemap --format=iife --target=es2020 --outfile=dist/inkrush.js --watch",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
